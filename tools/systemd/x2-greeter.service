# X2 auto-greeter. Third-party: nothing under /agibot is modified by this unit.
#
# The greeter only ever speaks and issues preset motions. It never changes the
# robot's motion mode, so starting at boot cannot make the robot stand or move
# on its own: outside force-control stand it speaks and refuses to gesture, and
# says so in the log. Bringing the robot to force-control stand stays a human
# action, with the remote.
[Unit]
Description=X2 auto-greeter
Documentation=file:///home/run/x2-auto-greeter/docs/AGENT_BRINGUP_GUIDE.md
# Start after the robot's own software, which owns the camera and the
# controller. Wants, not Requires: if the robot stack is down the greeter is
# useless but harmless, and a dependency failure loop helps nobody.
After=network-online.target agibot_software.service
Wants=agibot_software.service

[Service]
Type=simple
User=run
Group=run
ExecStart=/home/run/greeter_service.sh
# A crash should not leave the robot silently un-greeting for the rest of the
# day, but a crash loop should not hammer the controller either.
Restart=on-failure
RestartSec=30
StandardOutput=append:/home/run/greeter.log
StandardError=append:/home/run/greeter.log

[Install]
WantedBy=multi-user.target
